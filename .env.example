# Claude-Ops Configuration
# Copy this file to .env and fill in your actual values

# ==============================================
# ESSENTIAL SETTINGS (Required)
# ==============================================

# Telegram Bot Token
# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram Chat ID  
# Get this by messaging your bot and visiting:
# https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates
TELEGRAM_CHAT_ID=your_chat_id_here

# Allowed User IDs (comma-separated)
# These users can control the bot
# Find your user ID from the getUpdates response above
ALLOWED_USER_IDS=your_user_id_here

# ==============================================
# OPTIONAL SETTINGS (Defaults work fine)
# ==============================================

# Default working directory for Claude sessions
# If not set, uses current directory
# CLAUDE_WORKING_DIR=/path/to/your/projects

# How often to check Claude status (seconds)
# Default: 3
# CHECK_INTERVAL=3

# Logging level
# Options: DEBUG, INFO, WARNING, ERROR
# Default: INFO
# LOG_LEVEL=INFO

# ==============================================
# RELIABILITY IMPROVEMENTS (New in v2.1)
# ==============================================

# Session Reconnection Settings
# Maximum time to retry reconnecting to disconnected sessions (seconds)
# Default: 300 (5 minutes)
# SESSION_RECONNECT_MAX_DURATION=300

# Initial backoff delay for reconnection retries (seconds)
# Default: 1
# SESSION_RECONNECT_INITIAL_BACKOFF=1

# Maximum backoff delay for reconnection retries (seconds)
# Default: 30
# SESSION_RECONNECT_MAX_BACKOFF=30

# Telegram Rate Limiting
# Enable custom rate limit handling with exponential backoff
# Default: true
# TELEGRAM_RATE_LIMIT_ENABLED=true

# Initial backoff for rate limit retries (seconds)
# Default: 1
# TELEGRAM_BACKOFF_INITIAL=1

# Maximum backoff for rate limit retries (seconds)
# Default: 60
# TELEGRAM_BACKOFF_MAX=60

# Dangerous Command Confirmation
# Timeout for dangerous command confirmations (seconds)
# Default: 60
# COMMAND_CONFIRMATION_TIMEOUT=60

# Screen History Depth
# Number of screen lines to analyze for state detection
# Default: 200
# SESSION_SCREEN_HISTORY_LINES=200

# ==============================================
# DASHBOARD (ctb-dashboard, port 8420)
# ==============================================
# 이 파일은 systemd user 서비스에 EnvironmentFile 로 주입된다
# (deploy/ctb-dashboard.service 참조).
#
# 주의: systemd 는 인라인 주석을 값에서 제거하지 않는다.
#       'KEY=값  # 주석' 형태를 쓰지 말고 주석은 항상 별도 줄에 둘 것.
#       (그렇지 않으면 값에 '  # 주석'이 그대로 들어간다)

# 대시보드의 변경(mutating) 엔드포인트 인증 토큰
# prompt / interrupt / key / delete / focus-session 에 X-CTB-Secret 헤더로 요구됨.
# 미설정 시 변경 엔드포인트는 비활성(조회는 계속 동작).
# 생성: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# 교체 절차: 이 값 수정 → systemctl --user restart ctb-dashboard → 클라이언트 재입력
# CTB_CONTROL_SECRET=

# PI 리뷰 딥링크 HMAC 서명 키
# 미설정 시 빈 키로 서명/검증되어 링크 위조가 가능하므로 반드시 설정할 것.
# 값을 바꾸면 기존에 발행된 리뷰 링크는 모두 무효화된다.
# CTB_REVIEW_SECRET=

# 리뷰 세션 쿠키 서명 키
# 미설정 시 재시작마다 임의값이 생성되어 세션이 매번 무효화된다.
# SESSION_SECRET_KEY=

# 텔레그램 알림에 넣을 대시보드 딥링크 base URL
# 예: http://100.85.200.72:8420 (tailnet 주소)
# 알림의 "📱 바로 열기" 링크를 누르면 해당 세션 콘솔이 열린 상태로 대시보드가 뜬다.
# 미설정 시 그 줄만 생략된다 (깨진 링크를 보내지 않음).
# CTB_DASHBOARD_URL=

# 대시보드 리스닝 주소 (선택)
# 기본값 0.0.0.0 — systemd Restart=always 환경에서 특정 IP 하드 바인드는
# 부팅 시 인터페이스 미기동으로 재시작 루프를 만들 수 있어 opt-in으로 둔다.
# 설정한 주소에 bind 실패하면 경고 로그 후 0.0.0.0으로 폴백한다.
# LAN 차단은 방화벽이 담당한다 (deploy/firewall-8420.sh로 점검).
# CTB_BIND_HOST=

# ==============================================
# MULTI-USER DEPLOYMENT (For team setups)
# ==============================================
# Each user should have their own .env file with:
# - Their own Telegram bot token
# - Their personal chat ID
# - Their user ID in ALLOWED_USER_IDS
#
# See MULTI_USER_GUIDE.md for detailed instructions

# ==============================================
# QUICK START
# ==============================================
# 1. Copy this file: cp .env.example .env
# 2. Fill in the ESSENTIAL SETTINGS above
# 3. Run: uv sync (install dependencies)
# 4. Start bot: uv run python -m claude_ops.telegram.bot
#
# For detailed documentation:
# - CLAUDE.md - Complete system guide
# - README.md - Quick overview
# - QUICK_START.md - Step-by-step setup